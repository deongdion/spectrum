# Copy to .env and fill in. Find these under project Settings at https://app.photon.codes
# (PHOTON_PROJECT_ID / PHOTON_PROJECT_SECRET are accepted as aliases)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional: signing secret returned once by webhook registration (only for webhook mode)
SPECTRUM_WEBHOOK_SECRET=

# Optional: ffmpeg binary for voice-note m4a conversion (defaults to ffmpeg on PATH)
SPECTRUM_FFMPEG_PATH=

# ai.py: Anthropic Messages API (e.g. Z.ai GLM)
AI_API=anthropic-messages
AI_BASE_URL=https://api.z.ai/api/anthropic
AI_MODEL=glm-5.3-flash
AI_API_KEY=

# ai.py: or any OpenAI-compatible endpoint (e.g. Ollama)
# AI_API=openai-completions
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3.8-unc:256k
# AI_API_KEY=ollama
